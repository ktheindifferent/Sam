# CapRover Environment Configuration Example
# Copy this file to .env and configure for your CapRover deployment

# Enable CapRover mode (disables Docker container management)
CAPROVER=true

# Database Configuration
DATABASE_ENGINE=postgres
DATABASE_URL=postgres://sam_user:your_password@captain-postgres:5432/sam_db
# Or use individual PostgreSQL variables:
# PG_DBNAME=sam_db
# PG_USER=sam_user
# PG_PASS=your_password
# PG_ADDRESS=captain-postgres:5432

# Redis Configuration
# The CapRover deploy helper creates app `sam-redis`.
REDIS_URL=redis://srv-captain--sam-redis:6379

# External Voice Service
# The CapRover deploy helper creates app `sam-voice`.
TTS_URL=http://srv-captain--sam-voice:8002/tts
# TTS_API_KEY=your_tts_api_key
# TTS_DEFAULT_VOICE=default
# TTS_DEFAULT_LANGUAGE=en-US

# External STT Service
STT_URL=http://srv-captain--sam-voice:8002/stt
# STT_API_KEY=your_stt_api_key
# STT_MODEL=whisper-base

# SeaweedFS companion services
# The CapRover deploy helper creates master, volume, and filer apps.
SEAWEEDFS_MASTER_URL=http://srv-captain--sam-seaweed-master:9333
SEAWEEDFS_VOLUME_URL=http://srv-captain--sam-seaweed-volume:8080
SEAWEEDFS_FILER_URL=http://srv-captain--sam-seaweed-filer:8888

# Application Port (CapRover will set this automatically)
PORT=8000

# Crawler Configuration
# Set CRAWLER_DISABLED=true to keep the crawler stopped.
CRAWLER_DISABLED=false
# Page crawl concurrency. Keep low on small CapRover hosts.
CRAWLER_THREADS=2
# DNS discovery concurrency. DNS is lighter than page crawling, but still bounded.
CRAWLER_DNS_THREADS=4

# Other Sam Configuration
SAM_LOG_LEVEL=info
SAM_ENVIRONMENT=production
