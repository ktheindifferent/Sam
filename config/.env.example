# Database Configuration
# Options: sqlite (default), postgresql, mysql, mariadb
DATABASE_ENGINE=sqlite

# SQLite Configuration (used when DATABASE_ENGINE=sqlite)
SQLITE_PATH=./data/sam.db

# PostgreSQL Configuration (used when DATABASE_ENGINE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sam
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sampassword

# MySQL/MariaDB Configuration (used when DATABASE_ENGINE=mysql or mariadb)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=sam
MYSQL_USER=root
MYSQL_PASSWORD=sampassword

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# Application Settings
LOG_LEVEL=info
PORT=8080
HOST=0.0.0.0