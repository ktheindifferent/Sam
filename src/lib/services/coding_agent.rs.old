// Phase 5: Universal LLM provider trait
#[async_trait]
pub trait LLMProvider: Send + Sync {
    async fn generate_response(&self, prompt: &str, model: &str) -> Result<String>;
    async fn is_available(&self) -> bool;
    fn provider_name(&self) -> &str;
    async fn list_models(&self) -> Result<Vec<String>>;
}

// Phase 5: Ollama provider wrapper
pub struct OllamaProvider {
    service: OllamaService,
}

impl OllamaProvider {
    pub fn new(config: OllamaConfig) -> Self {
        Self {
            service: OllamaService::new(config),
        }
    }
}

#[async_trait]
impl LLMProvider for OllamaProvider {
    async fn generate_response(&self, prompt: &str, model: &str) -> Result<String> {
        let response = self.service.generate(model, prompt, None).await?;
        Ok(response.response)
    }

    async fn is_available(&self) -> bool {
        self.service.is_running().await
    }

    fn provider_name(&self) -> &str {
        "Ollama"
    }

    async fn list_models(&self) -> Result<Vec<String>> {
        let response = self.service.list_models().await?;
        Ok(response.models.into_iter().map(|m| m.name).collect())
    }
}

