// Manual Debug implementation since we can't derive it with trait objects
impl std::fmt::Debug for CodingAgentService {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("CodingAgentService")
            .field("current_provider", &self.current_provider)
            .field("provider_count", &self.providers.len())
            .field("config", &self.config)
            .finish()
    }
}

pub struct CodingAgentService {
    config: CodingAgentConfig,
    // Phase 5: Multi-provider support
    providers: HashMap<String, Box<dyn LLMProvider>>,
    current_provider: String,
    // Phase 5: Enhanced workspace integration
    workspace_context: Arc<tokio::sync::Mutex<WorkspaceContext>>,
    // Phase 5: Learning and adaptation
    learning_metrics: Arc<tokio::sync::Mutex<LearningMetrics>>,
    // Existing fields
    command_history: Arc<tokio::sync::Mutex<Vec<CommandHistoryEntry>>>,
    project_cache: Arc<tokio::sync::Mutex<Option<ProjectStructure>>>,
    code_templates: Arc<tokio::sync::Mutex<Vec<CodeTemplate>>>,
    performance_metrics: Arc<tokio::sync::Mutex<PerformanceMetrics>>,
}

// Phase 5: Workspace awareness for better context management
