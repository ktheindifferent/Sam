    /// Get available code templates for a project type
    pub async fn get_code_templates(&self, project_type: Option<ProjectType>) -> Vec<CodeTemplate> {
        let templates = self.code_templates.lock().await;
        match project_type {
            Some(ptype) => templates.iter()
                .filter(|t| t.language == ptype)
                .cloned()
                .collect(),
            None => templates.clone(),
        }
    }

    /// Generate code from template with variable substitution
    pub async fn generate_from_template(
        &self,
        template_name: &str,
        variables: std::collections::HashMap<String, String>,
    ) -> Result<String> {
        let templates = self.code_templates.lock().await;

        let template = templates.iter()
            .find(|t| t.name == template_name)
            .ok_or_else(|| anyhow::anyhow!("Template '{}' not found", template_name))?;

        let mut content = template.template_content.clone();

        // Substitute variables
        for var in &template.variables {
            let value = variables.get(&var.name)
                .or(var.default_value.as_ref())
                .ok_or_else(|| anyhow::anyhow!("Required variable '{}' not provided", var.name))?;

            content = content.replace(&format!("{{{}}}", var.name), value);
        }

        Ok(content)
    }

    /// Add custom code template
    pub async fn add_code_template(&self, template: CodeTemplate) {
        let mut templates = self.code_templates.lock().await;
        templates.push(template);
    }

    /// Update performance metrics
    async fn update_performance_metrics(&self, command: &str, success: bool, duration: std::time::Duration) {
        let mut metrics = self.performance_metrics.lock().await;

        metrics.total_commands_executed += 1;

        // Update average execution time
        let new_time = duration.as_secs_f64();
        metrics.average_execution_time = (metrics.average_execution_time * (metrics.total_commands_executed - 1) as f64 + new_time) / metrics.total_commands_executed as f64;

        // Update success rate
        let successful_commands = if success {
            (metrics.success_rate * (metrics.total_commands_executed - 1) as f64) + 1.0
        } else {
            metrics.success_rate * (metrics.total_commands_executed - 1) as f64
        };
        metrics.success_rate = successful_commands / metrics.total_commands_executed as f64;

        // Track command usage
        *metrics.most_used_commands.entry(command.split_whitespace().next().unwrap_or("unknown").to_string()).or_insert(0) += 1;
    }

    /// Get performance metrics
    pub async fn get_performance_metrics(&self) -> PerformanceMetrics {
        self.performance_metrics.lock().await.clone()
    }

    /// Generate refactoring suggestions
    pub async fn generate_refactoring_suggestions(&self, current_dir: &PathBuf) -> Result<Vec<RefactoringSuggestion>> {
        let structure = self.analyze_project_structure(current_dir).await?;
        let mut suggestions = Vec::new();

        // Analyze for common refactoring opportunities
        for source_file in &structure.source_files {
            if let Ok(content) = tokio::fs::read_to_string(current_dir.join(source_file)).await {
                suggestions.extend(self.analyze_file_for_refactoring(source_file, &content, &structure.project_type).await);
            }
        }

        // Sort by confidence score
        suggestions.sort_by(|a, b| b.confidence_score.partial_cmp(&a.confidence_score).unwrap_or(std::cmp::Ordering::Equal));

        Ok(suggestions)
    }

    /// Analyze a file for refactoring opportunities
    async fn analyze_file_for_refactoring(&self, file_path: &str, content: &str, project_type: &ProjectType) -> Vec<RefactoringSuggestion> {
        let mut suggestions = Vec::new();
        let lines: Vec<&str> = content.lines().collect();

        match project_type {
            ProjectType::Rust => {
                // Check for long functions
                if let Some(suggestion) = self.check_long_functions_rust(&lines, file_path) {
                    suggestions.push(suggestion);
                }

                // Check for missing error handling
                if let Some(suggestion) = self.check_missing_error_handling_rust(&lines, file_path) {
                    suggestions.push(suggestion);
                }

                // Check for duplicate code
                if let Some(suggestion) = self.check_duplicate_code_rust(&lines, file_path) {
                    suggestions.push(suggestion);
                }
            }
            ProjectType::JavaScript | ProjectType::TypeScript => {
                // Check for callback hell
                if let Some(suggestion) = self.check_callback_hell_js(&lines, file_path) {
                    suggestions.push(suggestion);
                }
            }
            _ => {}
        }

        suggestions
    }

    fn check_long_functions_rust(&self, lines: &[&str], file_path: &str) -> Option<RefactoringSuggestion> {
        let mut function_start = None;
        let mut brace_count = 0;
        let mut function_lines = 0;

        for (i, line) in lines.iter().enumerate() {
            let trimmed = line.trim();

            if trimmed.starts_with("fn ") || trimmed.contains("fn ") {
                function_start = Some(i);
                function_lines = 0;
                brace_count = 0;
            }

            if function_start.is_some() {
                function_lines += 1;
                brace_count += trimmed.chars().filter(|&c| c == '{').count() as i32;
                brace_count -= trimmed.chars().filter(|&c| c == '}').count() as i32;

                if brace_count == 0 && function_lines > 50 {
                    return Some(RefactoringSuggestion {
                        suggestion_type: RefactoringType::ExtractFunction,
                        description: format!("Function starting at line {} is {} lines long. Consider breaking it into smaller functions.", function_start.unwrap() + 1, function_lines),
                        affected_files: vec![file_path.to_string()],
                        commands: vec![
                            self.create_execution_request(
                                &format!("# Extract long function in {}", file_path),
                                "Break down long function into smaller, more manageable functions",
                                RiskLevel::Medium,
                                Some(300),
                            )
                        ],
                        confidence_score: 0.8,
                        impact_assessment: ImpactAssessment {
                            lines_affected: function_lines,
                            files_affected: 1,
                            breaking_changes: false,
                            test_updates_required: true,
                            documentation_updates_required: true,
                        },
                    });
                }
            }
        }

        None
    }

    fn check_missing_error_handling_rust(&self, lines: &[&str], file_path: &str) -> Option<RefactoringSuggestion> {
        let mut unwrap_count = 0;
        let mut expect_count = 0;

        for line in lines {
            unwrap_count += line.matches(".unwrap()").count();
            expect_count += line.matches(".expect(").count();
        }

        if unwrap_count + expect_count > 5 {
            return Some(RefactoringSuggestion {
                suggestion_type: RefactoringType::AddError,
                description: format!("Found {} unwrap() and {} expect() calls. Consider implementing proper error handling.", unwrap_count, expect_count),
                affected_files: vec![file_path.to_string()],
                commands: vec![
                    self.create_execution_request(
                        &format!("# Add error handling to {}", file_path),
                        "Replace unwrap() and expect() calls with proper error handling",
                        RiskLevel::Medium,
                        Some(600),
                    )
                ],
                confidence_score: 0.9,
                impact_assessment: ImpactAssessment {
                    lines_affected: unwrap_count + expect_count,
                    files_affected: 1,
                    breaking_changes: true,
                    test_updates_required: true,
                    documentation_updates_required: false,
                },
            });
        }

        None
    }

    fn check_duplicate_code_rust(&self, _lines: &[&str], _file_path: &str) -> Option<RefactoringSuggestion> {
        // Simplified duplicate detection - in a real implementation, this would be more sophisticated
        None
    }

    fn check_callback_hell_js(&self, lines: &[&str], file_path: &str) -> Option<RefactoringSuggestion> {
        let mut callback_depth: i32 = 0;
        let mut max_depth: i32 = 0;

        for line in lines {
            let trimmed = line.trim();
            if trimmed.contains("function(") || trimmed.contains("(") && trimmed.contains("=>{") {
                callback_depth += 1;
                max_depth = max_depth.max(callback_depth);
            }
            if trimmed.contains("})") {
                callback_depth = callback_depth.saturating_sub(1);
            }
        }

        if max_depth > 4 {
            return Some(RefactoringSuggestion {
                suggestion_type: RefactoringType::ExtractFunction,
                description: format!("Detected callback nesting depth of {}. Consider using async/await or promises.", max_depth),
                affected_files: vec![file_path.to_string()],
                commands: vec![
                    self.create_execution_request(
                        &format!("# Refactor callbacks in {}", file_path),
                        "Convert callback hell to async/await pattern",
                        RiskLevel::High,
                        Some(900),
                    )
                ],
                confidence_score: 0.7,
                impact_assessment: ImpactAssessment {
                    lines_affected: lines.len(),
                    files_affected: 1,
                    breaking_changes: true,
                    test_updates_required: true,
                    documentation_updates_required: false,
                },
            });
        }

        None
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::path::PathBuf;

    #[tokio::test]
    async fn test_coding_agent_creation() {
        let agent = CodingAgentService::new_with_defaults();
        assert_eq!(agent.config.default_model, "codellama:latest");
        assert!(agent.config.safe_commands.contains(&"ls".to_string()));
    }

    #[test]
    fn test_safe_command_check() {
        let agent = CodingAgentService::new_with_defaults();
        assert!(agent.is_safe_command("ls -la"));
        assert!(agent.is_safe_command("pwd"));
        assert!(!agent.is_safe_command("rm -rf /"));
        assert!(!agent.is_safe_command("sudo apt install"));
    }

    #[test]
    fn test_command_parsing() {
        let agent = CodingAgentService::new_with_defaults();
        let response = "You should run `ls -la` to see the files. Also try:\n```bash\npwd\necho hello\n```";

        let commands = agent.parse_commands_from_response(response);
        assert_eq!(commands.len(), 3);
        assert_eq!(commands[0].command, "ls -la");
        assert_eq!(commands[1].command, "pwd");
        assert_eq!(commands[2].command, "echo hello");
    }

    #[test]
    fn test_context_building() {
        let agent = CodingAgentService::new_with_defaults();
        let lines = vec![
            "line1".to_string(),
            "line2".to_string(),
            "line3".to_string(),
        ];

        let context = agent.build_context(&lines);
        assert_eq!(context, "line1\nline2\nline3");
    }
}