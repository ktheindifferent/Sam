// 4. Add sitemap discovery after successful domain crawl:
// After successfully crawling a domain's root, discover and process sitemaps:
async fn process_domain_sitemaps(domain: &str) {
    let sitemap_urls = super::sitemap::extract_urls_from_sitemaps(domain).await;
    if !sitemap_urls.is_empty() {
        log::info!("Found {} URLs in sitemaps for {}", sitemap_urls.len(), domain);
        super::metrics::record_sitemap_found(domain).await;
        
        // Add sitemap URLs to crawl queue
        for url in sitemap_urls.iter().take(100) { // Limit to avoid overwhelming
            // Create crawl jobs for sitemap URLs
            let mut job = CrawlJob::new(url.clone());
            job.depth = 1; // Start at depth 1 for sitemap URLs
            job.save().await;
        }
    }
}

