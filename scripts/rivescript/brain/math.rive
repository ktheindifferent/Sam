> object calculate python
    import math
    import re
    try:
        # Join all arguments into a single expression
        expression = " ".join(args)
        # Replace common mathematical notation
        expression = expression.replace("^", "**")  # exponentiation
        expression = expression.replace("π", str(math.pi))
        expression = expression.replace("pi", str(math.pi))
        expression = expression.replace("e", str(math.e))
        
        # Security: only allow safe mathematical operations
        allowed_chars = "0123456789+-*/().** "
        allowed_funcs = ["sin", "cos", "tan", "sqrt", "log", "exp", "abs", "pow"]
        
        # Basic validation
        if all(c in allowed_chars + "abcdefghijklmnopqrstuvwxyz" for c in expression.lower()):
            result = eval(expression, {"__builtins__": {}, "math": math})
            return f"{expression} = {result}"
        else:
            return "Invalid mathematical expression. Please use only numbers and basic operators."
    except Exception as e:
        return f"Error calculating: {expression}. Please check your syntax."
