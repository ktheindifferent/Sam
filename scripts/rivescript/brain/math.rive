> object percentage python
    try:
        if len(args) == 2:
            # What percent is X of Y?
            part, whole = float(args[0]), float(args[1])
            if whole == 0:
                return "Cannot calculate percentage of zero"
            percentage = (part / whole) * 100
            return f"{part} is {percentage:.2f}% of {whole}"
            
        elif len(args) == 3:
            operation = args[0].lower()
            if operation in ["of", "percent"]:
                # X percent of Y
                percent, number = float(args[1]), float(args[2])
                result = (percent / 100) * number
                return f"{percent}% of {number} = {result:.2f}"
            elif operation in ["increase", "plus"]:
                # Increase X by Y%
                number, percent = float(args[1]), float(args[2])
                result = number * (1 + percent / 100)
                return f"{number} increased by {percent}% = {result:.2f}"
            elif operation in ["decrease", "minus"]:
                # Decrease X by Y%
                number, percent = float(args[1]), float(args[2])
                result = number * (1 - percent / 100)
                return f"{number} decreased by {percent}% = {result:.2f}"
        
        return "Usage: percentage <part> <whole> OR percentage <operation> <number> <percent>"
        
    except ValueError:
        return "Please provide valid numeric values"
    except Exception as e:
        return f"Error calculating percentage: {str(e)}"
