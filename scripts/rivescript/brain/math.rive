> object statistics python
    import math
    try:
        if len(args) < 1:
            return "Please provide at least one number for statistical analysis"
        
        numbers = [float(arg) for arg in args]
        n = len(numbers)
        
        # Basic statistics
        total = sum(numbers)
        mean = total / n
        
        # Sort for median and quartiles
        sorted_nums = sorted(numbers)
        
        # Median
        if n % 2 == 0:
            median = (sorted_nums[n//2 - 1] + sorted_nums[n//2]) / 2
        else:
            median = sorted_nums[n//2]
        
        # Mode (most frequent)
        from collections import Counter
        counts = Counter(numbers)
        mode_count = max(counts.values())
        modes = [num for num, count in counts.items() if count == mode_count]
        
        # Standard deviation
        variance = sum((x - mean) ** 2 for x in numbers) / n
        std_dev = math.sqrt(variance)
        
        # Range
        data_range = max(numbers) - min(numbers)
        
        result = f"Statistics for {n} values:\n"
        result += f"Mean: {mean:.4f}\n"
        result += f"Median: {median:.4f}\n"
        result += f"Mode: {modes[0]:.4f}" + (f" (and {len(modes)-1} others)" if len(modes) > 1 else "") + "\n"
        result += f"Range: {data_range:.4f}\n"
        result += f"Standard Deviation: {std_dev:.4f}\n"
        result += f"Min: {min(numbers):.4f}, Max: {max(numbers):.4f}"
        
        return result
        
    except ValueError:
        return "Please provide valid numeric values"
    except Exception as e:
        return f"Error in statistical calculation: {str(e)}"
