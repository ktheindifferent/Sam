> object factorial python
    import math
    try:
        if len(args) != 1:
            return "Please provide one number for factorial calculation"
        
        n = int(args[0])
        if n < 0:
            return "Factorial is not defined for negative numbers"
        elif n > 170:  # Prevent overflow
            return "Number too large for factorial calculation (max 170)"
        
        result = math.factorial(n)
        return f"{n}! = {result:,}"
    except ValueError:
        return "Please provide a valid integer"
    except Exception as e:
        return f"Error calculating factorial: {str(e)}"
