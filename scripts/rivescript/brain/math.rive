> object number_theory python
    import math
    try:
        if len(args) < 2:
            return "Usage: number_theory <operation> <number(s)>"
        
        operation = args[0].lower()
        
        if operation == "factors":
            n = int(args[1])
            if n <= 0:
                return "Please provide a positive integer"
            
            factors = []
            for i in range(1, int(math.sqrt(n)) + 1):
                if n % i == 0:
                    factors.append(i)
                    if i != n // i:
                        factors.append(n // i)
            
            factors.sort()
            return f"Factors of {n}: {factors}"
            
        elif operation == "prime_factors":
            n = int(args[1])
            if n <= 1:
                return "Please provide an integer greater than 1"
            
            factors = []
            d = 2
            while d * d <= n:
                while n % d == 0:
                    factors.append(d)
                    n //= d
                d += 1
            if n > 1:
                factors.append(n)
            
            return f"Prime factorization: {' × '.join(map(str, factors))}"
            
        elif operation == "perfect":
            n = int(args[1])
            if n <= 1:
                return f"{n} is not a perfect number"
            
            divisor_sum = sum(i for i in range(1, n) if n % i == 0)
            
            if divisor_sum == n:
                return f"{n} is a perfect number!"
            else:
                return f"{n} is not a perfect number (sum of divisors = {divisor_sum})"
                
        else:
            return "Supported operations: factors, prime_factors, perfect"
            
    except ValueError:
        return "Please provide valid integers"
    except Exception as e:
        return f"Error in number theory calculation: {str(e)}"
< object

> object combinatorics python
    import math
    try:
        if len(args) < 3:
            return "Usage: combinatorics <operation> <n> <r>"
        
        operation = args[0].lower()
        n, r = int(args[1]), int(args[2])
        
        if n < 0 or r < 0:
            return "Please provide non-negative integers"
        
        if operation == "permutation" or operation == "p":
            if r > n:
                return "r cannot be greater than n for permutations"
            
            result = math.factorial(n) // math.factorial(n - r)
            return f"P({n}, {r}) = {result}"
            
        elif operation == "combination" or operation == "c":
            if r > n:
                return "r cannot be greater than n for combinations"
            
            result = math.factorial(n) // (math.factorial(r) * math.factorial(n - r))
            return f"C({n}, {r}) = {result}"
            
        else:
            return "Supported operations: permutation (or p), combination (or c)"
            
    except ValueError:
        return "Please provide valid integers"
    except Exception as e:
        return f"Error in combinatorics calculation: {str(e)}"
