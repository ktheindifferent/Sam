> object geometry python
    import math
    try:
        if len(args) < 2:
            return "Usage: geometry <shape> <parameters...>"
        
        shape = args[0].lower()
        params = [float(x) for x in args[1:]]
        
        if shape == "circle":
            if len(params) != 1:
                return "Circle requires radius"
            r = params[0]
            area = math.pi * r * r
            circumference = 2 * math.pi * r
            return f"Circle (r={r}): Area = {area:.4f}, Circumference = {circumference:.4f}"
            
        elif shape == "rectangle":
            if len(params) != 2:
                return "Rectangle requires length and width"
            l, w = params
            area = l * w
            perimeter = 2 * (l + w)
            return f"Rectangle ({l}×{w}): Area = {area:.4f}, Perimeter = {perimeter:.4f}"
            
        elif shape == "triangle":
            if len(params) == 2:  # base and height
                b, h = params
                area = 0.5 * b * h
                return f"Triangle (base={b}, height={h}): Area = {area:.4f}"
            elif len(params) == 3:  # three sides (Heron's formula)
                a, b, c = params
                s = (a + b + c) / 2  # semi-perimeter
                area = math.sqrt(s * (s - a) * (s - b) * (s - c))
                perimeter = a + b + c
                return f"Triangle (sides {a},{b},{c}): Area = {area:.4f}, Perimeter = {perimeter:.4f}"
            else:
                return "Triangle requires either (base, height) or (side1, side2, side3)"
                
        elif shape == "sphere":
            if len(params) != 1:
                return "Sphere requires radius"
            r = params[0]
            volume = (4/3) * math.pi * r**3
            surface_area = 4 * math.pi * r**2
            return f"Sphere (r={r}): Volume = {volume:.4f}, Surface Area = {surface_area:.4f}"
            
        else:
            return f"Shape '{shape}' not supported. Try: circle, rectangle, triangle, sphere"
            
    except ValueError:
        return "Please provide valid numeric parameters"
    except Exception as e:
        return f"Error in geometry calculation: {str(e)}"
