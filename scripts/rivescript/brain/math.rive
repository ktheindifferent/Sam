> object random_math python
    import random
    try:
        if len(args) == 0:
            operation = "problem"
        else:
            operation = args[0].lower()
        
        if operation == "problem":
            # Generate random math problems
            ops = ["+", "-", "*"]
            op = random.choice(ops)
            a = random.randint(1, 100)
            b = random.randint(1, 100)
            
            if op == "+":
                answer = a + b
                return f"Random problem: {a} + {b} = ?  (Answer: {answer})"
            elif op == "-":
                if a < b:  # Keep positive results
                    a, b = b, a
                answer = a - b
                return f"Random problem: {a} - {b} = ?  (Answer: {answer})"
            elif op == "*":
                answer = a * b
                return f"Random problem: {a} × {b} = ?  (Answer: {answer})"
                
        elif operation == "fact":
            facts = [
                "The word 'algebra' comes from the Arabic word 'al-jabr'",
                "Zero was invented by ancient Indian mathematicians",
                "The symbol π was first used by Welsh mathematician William Jones in 1706",
                "A 'jiffy' is an actual unit of time: 1/60th of a second",
                "The equal sign (=) was invented in 1557 by Welsh mathematician Robert Recorde",
                "Negative numbers were first accepted in Europe in the 15th century",
                "The word 'mathematics' comes from the Greek 'mathema' meaning 'learning'",
                "A palindromic number reads the same forwards and backwards, like 121 or 1331",
                "The golden ratio (φ ≈ 1.618) appears throughout art, architecture, and nature"
            ]
            return random.choice(facts)
        
        return "Try: 'random math problem' or 'random math fact'"
        
    except Exception as e:
        return f"Error generating random math content: {str(e)}"
