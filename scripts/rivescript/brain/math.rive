> object gcd_lcm python
    import math
    try:
        if len(args) != 2:
            return "Please provide exactly two numbers"
        
        a, b = int(args[0]), int(args[1])
        
        gcd = math.gcd(a, b)
        lcm = abs(a * b) // gcd if gcd != 0 else 0
        
        return f"GCD({a}, {b}) = {gcd}, LCM({a}, {b}) = {lcm}"
        
    except ValueError:
        return "Please provide valid integers"
    except Exception as e:
        return f"Error calculating GCD/LCM: {str(e)}"
