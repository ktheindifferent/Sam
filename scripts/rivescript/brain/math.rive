> object matrix python
    try:
        if len(args) < 1:
            return "Usage: matrix <operation> <data...>"
        
        operation = args[0].lower()
        
        if operation == "add":
            # Expects: add a11 a12 a21 a22 b11 b12 b21 b22 (2x2 matrices)
            if len(args) != 9:
                return "Matrix addition requires 8 values for two 2x2 matrices"
            
            vals = [float(x) for x in args[1:]]
            a = [[vals[0], vals[1]], [vals[2], vals[3]]]
            b = [[vals[4], vals[5]], [vals[6], vals[7]]]
            
            result = [[a[i][j] + b[i][j] for j in range(2)] for i in range(2)]
            
            return f"Matrix A + B = [[{result[0][0]}, {result[0][1]}], [{result[1][0]}, {result[1][1]}]]"
            
        elif operation == "multiply":
            # 2x2 matrix multiplication
            if len(args) != 9:
                return "Matrix multiplication requires 8 values for two 2x2 matrices"
            
            vals = [float(x) for x in args[1:]]
            a = [[vals[0], vals[1]], [vals[2], vals[3]]]
            b = [[vals[4], vals[5]], [vals[6], vals[7]]]
            
            result = [[0, 0], [0, 0]]
            for i in range(2):
                for j in range(2):
                    for k in range(2):
                        result[i][j] += a[i][k] * b[k][j]
            
            return f"Matrix A × B = [[{result[0][0]}, {result[0][1]}], [{result[1][0]}, {result[1][1]}]]"
            
        elif operation == "determinant":
            if len(args) != 5:
                return "Determinant calculation requires 4 values for a 2x2 matrix"
            
            vals = [float(x) for x in args[1:]]
            det = vals[0] * vals[3] - vals[1] * vals[2]
            
            return f"Determinant = {det}"
            
        else:
            return "Supported operations: add, multiply, determinant"
            
    except ValueError:
        return "Please provide valid numeric values"
    except Exception as e:
        return f"Error in matrix calculation: {str(e)}"
