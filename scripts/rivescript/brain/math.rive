> object compound_interest python
    try:
        if len(args) != 4:
            return "Usage: compound_interest <principal> <rate> <time> <compounds_per_year>"
        
        P = float(args[0])  # Principal
        r = float(args[1]) / 100  # Annual interest rate (convert percentage)
        t = float(args[2])  # Time in years
        n = float(args[3])  # Number of times compounded per year
        
        # A = P(1 + r/n)^(nt)
        A = P * (1 + r/n) ** (n * t)
        interest_earned = A - P
        
        return f"Principal: ${P:,.2f}, Rate: {args[1]}%, Time: {t} years, Compounded {n}x/year\nFinal Amount: ${A:,.2f}\nInterest Earned: ${interest_earned:,.2f}"
        
    except ValueError:
        return "Please provide valid numeric values"
    except Exception as e:
        return f"Error calculating compound interest: {str(e)}"
