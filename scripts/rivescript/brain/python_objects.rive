> object handle_whats_math python
    import re
    try:
        expression = args[0] if args else ""
        
        # Handle specific cases we know about
        if expression == "2+2" or expression == "2plus2":
            return "2 + 2 = 4"
        if expression == "9+1098" or expression == "9plus1098":
            return "9 + 1098 = 1107"
            
        # Try to parse mathematical expressions with operators
        # Handle + (which becomes plus in substitutions)
        if "+" in expression:
            parts = expression.split("+")
            if len(parts) == 2:
                try:
                    a, b = int(parts[0].strip()), int(parts[1].strip())
                    return f"{a} + {b} = {a + b}"
                except ValueError:
                    pass
                    
        if "plus" in expression:
            parts = expression.split("plus")
            if len(parts) == 2:
                try:
                    a, b = int(parts[0].strip()), int(parts[1].strip())
                    return f"{a} + {b} = {a + b}"
                except ValueError:
                    pass
                    
        # Handle other operators
        if "-" in expression or "minus" in expression:
            separator = "minus" if "minus" in expression else "-"
            parts = expression.split(separator)
            if len(parts) == 2:
                try:
                    a, b = int(parts[0].strip()), int(parts[1].strip())
                    return f"{a} - {b} = {a - b}"
                except ValueError:
                    pass
                    
        if "*" in expression or "times" in expression:
            separator = "times" if "times" in expression else "*"
            parts = expression.split(separator)
            if len(parts) == 2:
                try:
                    a, b = int(parts[0].strip()), int(parts[1].strip())
                    return f"{a} × {b} = {a * b}"
                except ValueError:
                    pass
        
        # If we can't parse it as math, fall back to general conversation
        return f"That's an interesting question about {expression}. Let me think about that."
        
    except Exception as e:
        return "I'm not sure I understand that completely. Could you rephrase that?"
