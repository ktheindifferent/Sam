> object parse_attached_math python
    import re
    try:
        if len(args) != 1:
            return "Invalid math expression format"
        
        expression = args[0]
        
        # Handle patterns like "2plus2", "9minus3", "5times4" 
        if "plus" in expression:
            parts = expression.split("plus")
            if len(parts) == 2:
                try:
                    a, b = int(parts[0]), int(parts[1])
                    result = a + b
                    return f"{a} + {b} = {result}"
                except ValueError:
                    return "Invalid numbers in expression"
                    
        elif "minus" in expression:
            parts = expression.split("minus")
            if len(parts) == 2:
                try:
                    a, b = int(parts[0]), int(parts[1])
                    result = a - b
                    return f"{a} - {b} = {result}"
                except ValueError:
                    return "Invalid numbers in expression"
                    
        elif "times" in expression:
            parts = expression.split("times")
            if len(parts) == 2:
                try:
                    a, b = int(parts[0]), int(parts[1])
                    result = a * b
                    return f"{a} × {b} = {result}"
                except ValueError:
                    return "Invalid numbers in expression"
                    
        elif "divided" in expression:
            parts = expression.split("divided")
            if len(parts) == 2:
                try:
                    a, b = int(parts[0]), int(parts[1])
                    if b == 0:
                        return "Cannot divide by zero"
                    result = a / b
                    if result.is_integer():
                        result = int(result)
                    return f"{a} ÷ {b} = {result}"
                except ValueError:
                    return "Invalid numbers in expression"
        
        return f"Could not parse math expression: {expression}"
        
    except Exception as e:
        return f"Error parsing math expression: {str(e)}"
