> object generate_password python
    import random
    import string
    length = int(args[0]) if args and args[0].isdigit() else 12
    chars = string.ascii_letters + string.digits + "!@#$%^&*"
    password = ''.join(random.choice(chars) for _ in range(length))
    return password
