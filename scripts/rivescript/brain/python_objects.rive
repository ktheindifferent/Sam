> object handle_whats_expression python
    import re
    try:
        if len(args) != 1:
            return "I'm not sure what you're asking about."
        
        expression = args[0].strip()
        
        # Check for mathematical expressions with operators (before substitution)
        math_pattern = r'^(\d+)\s*([+\-*/])\s*(\d+)$'
        match = re.match(math_pattern, expression)
        
        if match:
            left, op, right = match.groups()
            a, b = int(left), int(right)
            
            if op == '+':
                result = a + b
                return f"{a} + {b} = {result}"
            elif op == '-':
                result = a - b
                return f"{a} - {b} = {result}"
            elif op == '*':
                result = a * b
                return f"{a} × {b} = {result}"
            elif op == '/':
                if b == 0:
                    return "Cannot divide by zero"
                result = a / b
                if result.is_integer():
                    result = int(result)
                return f"{a} ÷ {b} = {result}"
        
        # Check for common directory/location queries
        # Note: preprocessing may convert "whats" to "is", so account for both
        dir_patterns = [
            r'(is\s+)?in\s+(this|the)\s+(folder|directory)',
            r'(is\s+)?in\s+the\s+current\s+directory',
            r'files\s+(here|in\s+this)',
            r'contents?\s+of\s+(this|current)',
            r'(what|whats?)\s+(files?|contents?)\s+(are\s+)?(here|in\s+this)',
            r'(show|list)\s+(files?|contents?)',
        ]
        
        for dir_pattern in dir_patterns:
            if re.search(dir_pattern, expression.lower()):
                return "I'll list the files in the current directory. ::::: ls :::::"
        
        # If not a simple math expression or directory query, fall back to generic response
        return f"That's an interesting question about {expression}. Let me think about that."
        
    except Exception as e:
        return f"I'm not sure what you're asking about."
