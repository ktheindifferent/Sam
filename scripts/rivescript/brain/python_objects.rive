> object parse_simple_math python
    try:
        if len(args) != 3:
            return "Invalid math expression format"
        
        # args should be [number, operator, number]
        left, op, right = args[0], args[1], args[2]
        
        try:
            a, b = int(left), int(right)
            if op == '+':
                result = a + b
                return f"{a} + {b} = {result}"
            elif op == '-':
                result = a - b
                return f"{a} - {b} = {result}"
            elif op == '*' or op == 'x':
                result = a * b
                return f"{a} × {b} = {result}"
            elif op == '/' or op == '÷':
                if b == 0:
                    return "Cannot divide by zero"
                result = a / b
                if result.is_integer():
                    result = int(result)
                return f"{a} ÷ {b} = {result}"
            else:
                return f"Unknown operator: {op}"
        except ValueError:
            return "Please provide valid numbers"
    except Exception as e:
        return f"Error in calculation: {str(e)}"
