diff --git a/src/lib/memory/config/mod.rs b/src/lib/memory/config/mod.rs
index original..fixed 100644
--- a/src/lib/memory/config/mod.rs
+++ b/src/lib/memory/config/mod.rs
@@ -731,9 +731,19 @@ impl Config {
 
     /// Validates a SQL identifier to prevent SQL injection
+    /// 
+    /// # Security
+    /// This function enforces strict validation on SQL identifiers (table names,
+    /// column names, database names) to prevent SQL injection attacks.
+    /// 
+    /// Only alphanumeric characters and underscores are allowed, and SQL
+    /// keywords are explicitly rejected. Maximum length is 63 characters
+    /// (PostgreSQL limit).
     fn validate_sql_identifier(identifier: &str) -> Result<()> {
         // SQL identifiers should only contain alphanumeric characters, underscores, and be non-empty
+        // This prevents:
+        // - Comment injection (-- or /*)
+        // - Quote injection (' or ")
+        // - SQL keyword injection (DROP, DELETE, etc)
         if identifier.is_empty() {
             return Err(MemoryError::Other("SQL identifier cannot be empty".to_string()).into());
         }
