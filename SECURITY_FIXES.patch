-    pub fn add_limit(mut self, limit: i64) -> Self {
+    pub fn add_limit(mut self, limit: i64) -> Result<Self, String> {
+        // SECURITY: Validate numeric range
+        // PostgreSQL LIMIT cannot use parameterized queries, so we validate the value
+        const MAX_LIMIT: i64 = 10_000;
+        
+        if limit < 0 {
+            return Err(format!("LIMIT value cannot be negative: {}", limit));
+        }
+        if limit > MAX_LIMIT {
+            return Err(format!("LIMIT value exceeds maximum allowed ({}): {}", MAX_LIMIT, limit));
+        }
+        
         self.query.push_str(&format!(" LIMIT {}", limit));
-        self
+        Ok(self)
     }
 
-    pub fn add_offset(mut self, offset: i64) -> Self {
+    pub fn add_offset(mut self, offset: i64) -> Result<Self, String> {
+        const MAX_OFFSET: i64 = 1_000_000;
+        
+        if offset < 0 {
+            return Err(format!("OFFSET value cannot be negative: {}", offset));
+        }
+        if offset > MAX_OFFSET {
+            return Err(format!("OFFSET value exceeds maximum allowed ({}): {}", MAX_OFFSET, offset));
+        }
+        
         self.query.push_str(&format!(" OFFSET {}", offset));
-        self
+        Ok(self)
     }
 
